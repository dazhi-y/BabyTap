# Copy values into your shell or a local .env loader. Never commit real values.
BABYTAP_BABYBUDDY_URL=http://127.0.0.1:8000
BABYTAP_BABYBUDDY_TOKEN=replace-with-local-token
BABYTAP_BABYBUDDY_CHILD_ID=1
BABYTAP_BOTTLE_TYPE=breast milk
BABYTAP_DB_PATH=app/data/babytap.sqlite3

# HID may stay disabled when system keyboard shortcuts carry K1-K8.
BABYTAP_ENABLE_HID=0
# K3/K4 currently use the computer microphone. Enable only for hardware audio tests.
BABYTAP_ENABLE_AUDIO=0
